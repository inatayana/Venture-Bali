# Venture Bali — npm configuration
#
# The default npm settings are too aggressive for slow or flaky networks:
# a single package fetch can abort after a short timeout and the whole
# install restarts from scratch. The settings below make npm wait longer and
# retry harder, and prefer the local cache when it already holds the file.

# Be patient — a slow registry should not abort a 2,000+ package install.
fetch-timeout=600000
fetch-retries=5
fetch-retry-factor=10
fetch-retry-mintimeout=60000
fetch-retry-maxtimeout=300000

# Use the local cache when it already has the exact version we ask for.
prefer-offline=true

# Keep the install reproducible and the cache usable in CI.
audit=false
fund=false
