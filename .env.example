# =============================================================================
# BaliWild — Environment Variables Template
# =============================================================================
# Copy this file to `.env` for local development:  cp .env.example .env
# NEVER commit `.env` or any file containing real values.
# All variables used in code MUST be documented here (AGENTS.md §7).
#
# Scope legend:
#   [SERVER]  → server only, NEVER expose to browser, NEVER prefix NEXT_PUBLIC_
#   [PUBLIC]  → safe for browser, may be prefixed NEXT_PUBLIC_
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# -----------------------------------------------------------------------------
# Production: use the Supabase Transaction Pooler (port 6543) so serverless
# functions do not exhaust the connection limit.
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:6543/postgres?pgbouncer=true
# Local development: use the direct connection (port 5432).
#   postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Demo/preview builds run without a real database (mock data) — this var can be omitted.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"

# [SERVER] Direct (non-pooled) connection, port 5432. Used by Prisma migrations
# only; runtime queries use the pooled DATABASE_URL above.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase — Backend Services
# -----------------------------------------------------------------------------
# [PUBLIC] Project URL — Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# [PUBLIC] Anon / public key — Supabase Dashboard → Settings → API
# Safe for the browser, but protected by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# [SERVER] Service role key — Supabase Dashboard → Settings → API
# ⚠️  BYPASSES Row Level Security. Server only. NEVER commit, NEVER prefix
#     with NEXT_PUBLIC_, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Admin / Operator Panel
# -----------------------------------------------------------------------------
# [SERVER] Secret used to sign the operator session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters. Rotating it invalidates every active session.
ADMIN_SESSION_SECRET=""

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# [PUBLIC] Public base URL of the deployed app.
# Drives canonical URLs, sitemap.xml, review QR links and email links.
NEXT_PUBLIC_APP_URL="https://baliwild.com"

# -----------------------------------------------------------------------------
# Midtrans Payment
# -----------------------------------------------------------------------------
# [SERVER] Server key — Midtrans Dashboard → Settings → Access Keys
MIDTRANS_SERVER_KEY=""

# [SERVER] Client key — Midtrans Dashboard → Settings → Access Keys
MIDTRANS_CLIENT_KEY=""

# [SERVER] "true" for production Midtrans, "false" (or omitted) for sandbox
MIDTRANS_IS_PRODUCTION=""

# [PUBLIC] Public client key exposed to the Snap.js checkout page (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=""

# -----------------------------------------------------------------------------
# AI (Gemini)
# -----------------------------------------------------------------------------
# [SERVER] API key from Google AI Studio — used by the AI Content Wizard
# and the Customer Service Agent.
GEMINI_API_KEY=""

# [SERVER] Optional model override. The default is gemini-3.8-flash, which is
# the current free-tier model. Google retired gemini-2.0-flash, so keep this
# in sync with the model list in the Google AI console.
GEMINI_MODEL="gemini-3.8-flash"

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# [SERVER] Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# [SERVER] Secret token set via setWebhook's `secret_token`. Telegram echoes it
# in the X-Telegram-Bot-Api-Secret-Token header; requests without it are rejected
# in production.
TELEGRAM_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------
# [SERVER] All values from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v18.0"

# [SERVER] Random string you choose. Must match the token configured in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# [SERVER] Meta App Secret (App settings → Basic). Verifies the
# X-Hub-Signature-256 header on every inbound webhook. Refused in production
# when empty.
WHATSAPP_APP_SECRET=""

# -----------------------------------------------------------------------------
# Exchange Rates (multi-currency display)
# -----------------------------------------------------------------------------
# [SERVER] API key from exchangerate.host (or equivalent provider)
EXCHANGERATE_API_KEY=""

# -----------------------------------------------------------------------------
# Transactional email — Resend HTTP API (plain fetch, no SDK dependency)
# -----------------------------------------------------------------------------
# [SERVER] API key from https://resend.com/api-keys
RESEND_API_KEY=""

# [SERVER] Verified sender address. Use the transactional mailbox; replies are
# routed to support@baliwild.com by the notification layer.
#   hello@baliwild.com    general enquiries (site header/footer)
#   booking@baliwild.com  transactional: confirmations, vouchers, invoices
#   support@baliwild.com  complaints, reschedule, refund, on-trip emergency
#   partners@baliwild.com partnerships (b2b@baliwild.com is an alias)
EMAIL_FROM="BaliWild <booking@baliwild.com>"

# -----------------------------------------------------------------------------
# Cron jobs (Vercel Cron → vercel.json)
# -----------------------------------------------------------------------------
# [SERVER] Random secret. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Hybrid checkout — inventory hold & customer magic link
# -----------------------------------------------------------------------------
# [SERVER] Minutes a PENDING booking keeps its slot reserved (default 10).
BOOKING_HOLD_MINUTES="10"

# [SERVER] Secret used to sign the password-less "my bookings" link.
# Falls back to ADMIN_SESSION_SECRET when left empty.
CUSTOMER_LINK_SECRET=""
