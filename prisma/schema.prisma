generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum FulfillmentMode {
  SELF_DRIVE
  SHARED_TRANSFER
  PRIVATE_TRANSFER
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
}

enum PickupZoneType {
  ZONE_1
  ZONE_2
  ZONE_3
  ZONE_4
}

enum VehicleClassType {
  STANDARD_SUV
  PREMIUM_MPV
  MINIVAN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

/// Operational lifecycle of a reservation, separate from the payment status.
/// AWAITING_PAYMENT → CONFIRMED (paid) → COMPLETED (voucher redeemed) | NO_SHOW.
enum BookingLifecycle {
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum NotificationType {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ============ CORE MODELS ============

model Tenant {
  id        String    @id @default(cuid())
  domain    String    @unique
  name      String
  themeColor String   @default("#1E40AF")
  logoUrl   String?
  isActive  Boolean   @default(true)
  ventures  Venture[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Location {
  id        String    @id @default(cuid())
  name      String
  region    String
  latitude  Float
  longitude Float
  ventures  Venture[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([region])
}

model PickupZone {
  id            String         @id @default(cuid())
  name          String         @unique
  areaType      PickupZoneType
  surchargeIdr  Int            @default(0)
  isCustomQuote Boolean        @default(false)
  vehicleMaxPax Int            @default(4)
  isActive      Boolean        @default(true)
  bookings      Booking[]
  /// Packages that are sold with pickup locked to this zone (see
  /// docs/BOOKING_ARCHITECTURE.md §1 "zone-locked packages").
  variants      Variant[]      @relation("PickupZoneToVariant")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([areaType])
  @@index([isActive])
}

// Fleet classes for PRIVATE_TRANSFER (Klook-style configurator).
// Display labels use generic class names only — never vendor names (OPERATION_CONTRACT.md §1).
model VehicleClass {
  id            String           @id @default(cuid())
  name          VehicleClassType @unique
  label         String
  description   String?
  vehicleMaxPax Int              @default(4)
  deltaIdr      Int              @default(0)
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  bookings      Booking[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive])
}

model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  countryCode   String
  whatsapp      String
  totalBookings Int       @default(0)
  bookings      Booking[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([name])
}

// ============ PRODUCT MODELS ============

model Venture {
  id                String     @id @default(cuid())
  slug              String     @unique
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  locationId        String?
  location          Location?  @relation(fields: [locationId], references: [id])
  title             String
  hook3Sec          String
  shortDescription  String?
  /// Long-form "about + what to expect + what you get + what we expect" copy.
  /// Used by the product page's collapsible description; short copy stays for cards/meta.
  longDescription   String?    @db.Text
  duration          String
  badge             String?
  /// Where guests meet for SELF_DRIVE packages.
  meetingPoint      String?
  meetingPointLat   Float?
  meetingPointLng   Float?
  /// Structured safety requirements shown on the product page.
  minAge            Int?
  maxWeightKg       Int?
  safetyBriefing    String?
  highlights        Json
  inclusions        Json
  exclusions        Json
  itinerary         Json
  essentialInfo     Json
  faqs              Json       @default("[]")
  languages         Json
  category          String
  subcategory       String?
  primaryKeyword    String?
  secondaryKeywords Json       @default("[]")
  searchTags        Json       @default("[]")
  difficulty        Difficulty @default(EASY)
  suitableFor       Json       @default("[]")
  imageUrl          String
  gallery           Json
  videoUrl          String?
  rating            Float      @default(5.0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([slug])
  @@index([tenantId])
  @@index([locationId])
  @@index([category])
  @@index([difficulty])
  @@index([rating])
  variants    Variant[]     @relation("VentureToVariant")
  articles    Article[]     @relation("VentureToArticle")
  reviews     Review[]      @relation("VentureToReview")
  mediaAssets MediaAsset[]  @relation("VentureToMediaAsset")
}

model Variant {
  id               String      @id @default(cuid())
  ventureId        String
  venture          Venture     @relation("VentureToVariant", fields: [ventureId], references: [id], onDelete: Cascade)
  title            String
  shortDescription String
  badge            String?
  /// Transport / tier badge shown on the catalogue card (📍 / 🚐 / 🚗 / 🏛️).
  transportBadge   String?
  /// Optional image used by the gallery when this package is selected.
  imageUrl         String?
  /// Human-readable duration for this variant, e.g. "3 hrs".
  duration         String?
  /// Fulfillment mode this variant sells. The UI derives pickup steps from it.
  fulfillmentMode  FulfillmentMode @default(SELF_DRIVE)
  /// List price per pax is stored in PriceTier; this is the active promo price (IDR).
  /// When set (and lower than the tier price) the UI renders a strikethrough price.
  promoPriceIdr    Int?
  /// Operational notes shown under the price, e.g. "After 7 PM: +Rp50.000/pax".
  operationNotes   String?
  /// Package-level inclusions/exclusions; empty falls back to the venture lists.
  inclusions       Json        @default("[]")
  exclusions       Json        @default("[]")
  /// Optional minimum spend for this package (IDR). Enforced by computeQuote.
  minimumSpendIdr  Int?
  /// Zone-locked pickup. When set, the package already sells pickup from this
  /// zone: the booking sheet preselects and locks it, and the zone surcharge is
  /// still applied once by the pricing engine (never baked into the tier price).
  pickupZoneId     String?
  pickupZone       PickupZone? @relation("PickupZoneToVariant", fields: [pickupZoneId], references: [id], onDelete: SetNull)
  sortOrder        Int         @default(0)
  priceTiers       PriceTier[] @relation("VariantToPriceTier")
  blackoutDates    Json
  slotTimes        SlotTime[]  @relation("SlotTimeToVariant")
  addons           Addon[]     @relation("AddonToVariant")
  bookings         Booking[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([ventureId])
  @@index([pickupZoneId])
}

model PriceTier {
  id          String  @id @default(cuid())
  minPax      Int
  maxPax      Int
  pricePerPax Int
  variantId   String
  variant     Variant @relation("VariantToPriceTier", fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model SlotTime {
  id              String   @id @default(cuid())
  variantId       String
  variant         Variant  @relation("SlotTimeToVariant", fields: [variantId], references: [id], onDelete: Cascade)
  time            String
  maxCapacity     Int
  currentBookings Int      @default(0)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookings        Booking[]

  @@index([variantId])
}

model Addon {
  id               String   @id @default(cuid())
  variantId        String
  variant          Variant  @relation("AddonToVariant", fields: [variantId], references: [id], onDelete: Cascade)
  name             String
  price            Int
  description      String?
  requiresTransfer Boolean  @default(false)
  isCombo          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([variantId])
}

// ============ BOOKING & PAYMENT MODELS ============

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  label           String
  discountPercent Int
  minPax          Int       @default(1)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  usageLimit      Int?
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
}

model Booking {
  id               String          @id @default(cuid())
  bookingCode      String          @unique
  variantId        String
  variant          Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingDate      String
  slotTimeId       String?
  slotTime         SlotTime?       @relation(fields: [slotTimeId], references: [id])
  fulfillmentMode  FulfillmentMode
  pickupZoneId     String?
  pickupZone       PickupZone?     @relation(fields: [pickupZoneId], references: [id])
  vehicleClassId   String?
  vehicleClass     VehicleClass?   @relation(fields: [vehicleClassId], references: [id])
  hotelAddress     String?
  /// True when the guest will confirm the pickup address by H-1 (TBA flow).
  isTba            Boolean         @default(false)
  paxCount         Int
  vehicleCount     Int             @default(1)
  zoneSurchargeIdr Int             @default(0)
  /// Night-slot surcharge captured at booking time (IDR).
  nightSurchargeIdr Int            @default(0)
  /// Total discount captured at booking time (promo or coupon, never both).
  discountIdr      Int             @default(0)
  appliedCouponCode String?
  selectedAddons   Json
  totalPrice       Int
  paymentStatus    PaymentStatus
  /// Legal acceptance captured at checkout (versioned for audits).
  termsAcceptedAt  DateTime?
  waiverAcceptedAt DateTime?
  waiverVersion    String?
  billingAddress   Json?
  /// Operational lifecycle used by the field-team job order.
  lifecycleStatus  BookingLifecycle @default(AWAITING_PAYMENT)
  /// End of the temporary inventory hold. Null once paid or for legacy rows.
  expiresAt        DateTime?
  payment          Payment?
  vouchers         Voucher[]
  review           Review?         @relation("BookingToReview")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([bookingCode])
  @@index([variantId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([fulfillmentMode])
  @@index([pickupZoneId])
  @@index([vehicleClassId])
  @@index([bookingDate, lifecycleStatus])
  @@index([paymentStatus, expiresAt])
}

model Payment {
  id              String         @id @default(cuid())
  bookingId       String         @unique
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  midtransOrderId String
  snapToken       String?
  redirectUrl     String?
  paymentMethod   String?
  grossAmount     Int
  transactionTime DateTime?
  rawResponse     Json?
  status          PaymentStatus
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([bookingId])
  @@index([midtransOrderId])
  @@index([status])
}

model Voucher {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  qrCodeData  String
  issuedAt    DateTime      @default(now())
  redeemedAt  DateTime?
  redeemedBy  String?
  status      VoucherStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ============ CONTENT MODELS ============

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       Json
  content     String    @db.Text
  metaDesc    Json
  keywords    Json
  tags        Json
  publishedAt DateTime?
  aiGenerated Boolean   @default(false)
  ventureId   String?
  venture     Venture?  @relation("VentureToArticle", fields: [ventureId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([ventureId])
  @@index([publishedAt])
  @@index([aiGenerated])
}

model Review {
  id         String   @id @default(cuid())
  ventureId  String
  venture    Venture  @relation("VentureToReview", fields: [ventureId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  /// Booking the review belongs to. Present = verified trip; unique = one review per booking.
  bookingId  String?  @unique
  booking    Booking? @relation("BookingToReview", fields: [bookingId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String   @db.Text
  /// Reserved for guest photos (URLs); rendered once storage is configured.
  photos     Json     @default("[]")
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ventureId, isApproved])
  @@index([customerId])
  @@index([rating])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  altText   String
  width     Int?
  height    Int?
  size      Int?
  isPrimary Boolean  @default(false)
  ventureId String?
  venture   Venture? @relation("VentureToMediaAsset", fields: [ventureId], references: [id])
  createdAt DateTime @default(now())

  @@index([ventureId])
  @@index([isPrimary])
}

model NotificationLog {
  id           String             @id @default(cuid())
  bookingId    String?
  customerId   String?
  type         NotificationType
  recipient    String
  subject      String?
  content      String
  status       NotificationStatus @default(PENDING)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime           @default(now())

  @@index([bookingId])
  @@index([customerId])
  @@index([type])
  @@index([status])
}

// ============ AI AGENT MODELS ============

/// A conversation with the customer service agent.
/// One row per channel user, so the agent keeps its context between turns.
model AgentSession {
  id           String   @id @default(cuid())
  /// Stable identifier, e.g. "wa_628123456789" or "tg_12345".
  sessionKey   String   @unique
  channel      String
  language     String   @default("id")
  userId       String?
  phone        String?
  /// The current product the conversation is about.
  productId    String?
  variantId    String?
  paxCount     Int?
  bookingDate  String?
  /// The detected intent of the last turn.
  intent       String?
  /// Recent turns, oldest first, as a JSON array of { role, text }.
  history      Json     @default("[]")
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([channel])
  @@index([lastActiveAt])
}
