generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum MeetingType {
  MEETING_POINT
  HOTEL_PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum NotificationType {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ============ CORE MODELS ============

model Tenant {
  id            String   @id @default(cuid())
  domain        String   @unique
  name          String
  themeColor    String   @default("#1E40AF")
  logoUrl       String?
  isActive      Boolean  @default(true)
  ventures      Venture[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Location {
  id          String   @id @default(cuid())
  name        String
  region      String
  latitude    Float
  longitude   Float
  ventures    Venture[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([region])
}

model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  countryCode   String
  whatsapp      String
  totalBookings Int       @default(0)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([name])
}

model Venture {
  id              String   @id @default(cuid())
  slug            String   @unique
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  title           String
  hook3Sec        String
  duration        String
  badge           String?
  highlights      Json
  inclusions      Json
  exclusions      Json
  itinerary       Json
  essentialInfo   Json
  languages       Json
  category        String
  imageUrl        String
  gallery         Json
  rating          Float @default(5.0)

  @@index([slug])
  @@index([tenantId])
  @@index([locationId])
  @@index([category])
  @@index([rating])
  variants        Variant[] @relation("VentureToVariant")
  articles        Article[] @relation("VentureToArticle")
  reviews         Review[]  @relation("VentureToReview")
  mediaAssets     MediaAsset[] @relation("VentureToMediaAsset")
}

model Variant {
  id               String   @id @default(cuid())
  ventureId        String
  venture          Venture @relation("VentureToVariant", fields: [ventureId], references: [id], onDelete: Cascade)
  title            String
  shortDescription String
  badge            String?
  meetingType      MeetingType
  priceTiers       PriceTier[] @relation("VariantToPriceTier")
  blackoutDates    Json
  slotTimes        SlotTime[] @relation("SlotTimeToVariant")
  addons           Addon[] @relation("AddonToVariant")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ventureId])
}

model PriceTier {
  id         String  @id @default(cuid())
  minPax     Int
  maxPax     Int
  pricePerPax Float
  variant     Variant?  @relation("VariantToPriceTier")
}

model SlotTime {
  id            String   @id @default(cuid())
  variantId     String
  variant       Variant  @relation("SlotTimeToVariant", fields: [variantId], references: [id], onDelete: Cascade)
  time          String
  maxCapacity   Int
  currentBookings Int @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([variantId])
}

model Addon {
  id            String   @id @default(cuid())
  variantId     String
  variant       Variant  @relation("AddonToVariant", fields: [variantId], references: [id], onDelete: Cascade)
  name          String
  price         Float
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([variantId])
}

// ============ BOOKING & PAYMENT MODELS ============

model Booking {
  id              String    @id @default(cuid())
  bookingCode     String    @unique
  variantId       String
  variant         Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingDate     String
  slotTimeId      String?
  slotTime        SlotTime?
  meetingType     MeetingType
  hotelAddress    String?
  paxCount        Int
  selectedAddons  Json
  totalPrice      Float
  paymentStatus   PaymentStatus
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookingCode])
  @@index([variantId])
  @@index([customerId])
  @@index([paymentStatus])
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  midtransOrderId   String
  snapToken         String?
  redirectUrl       String?
  paymentMethod     String?
  grossAmount       Float
  transactionTime   DateTime?
  rawResponse       Json?
  status            PaymentStatus
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([bookingId])
  @@index([midtransOrderId])
  @@index([status])
}

model Voucher {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id])
  qrCodeData    String
  issuedAt      DateTime  @default(now())
  redeemedAt    DateTime?
  redeemedBy    String?
  status        VoucherStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ============ CONTENT MODELS ============

model Article {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        Json
  content      String    @db.Text
  metaDesc     Json
  keywords     Json
  tags         Json
  publishedAt  DateTime?
  aiGenerated  Boolean   @default(false)
  ventureId    String?
  venture      Venture?  @relation(fields: [ventureId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([ventureId])
  @@index([publishedAt])
  @@index([aiGenerated])
}

model Review {
  id         String    @id @default(cuid())
  ventureId  String
  venture    Venture   @relation(fields: [ventureId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String    @db.Text
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([ventureId, isApproved])
  @@index([customerId])
  @@index([rating])
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  altText   String
  width     Int?
  height    Int?
  size      Int?
  isPrimary Boolean   @default(false)
  ventureId String?
  venture   Venture?  @relation(fields: [ventureId], references: [id])
  createdAt DateTime  @default(now())

  @@index([ventureId])
  @@index([isPrimary])
}

model NotificationLog {
  id           String    @id @default(cuid())
  bookingId    String?
  customerId   String?
  type         NotificationType
  recipient    String
  subject      String?
  content      String
  status       NotificationStatus @default(PENDING)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([bookingId])
  @@index([customerId])
  @@index([type])
  @@index([status])
}
